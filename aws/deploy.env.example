# CloudFormation / CodePipeline deploy parameters
# Usage:
#   copy aws\deploy.env.example aws\deploy.env
#   Edit aws\deploy.env (Connection ARN, repository, etc.)
#   Run 02_aws-deploy.bat or aws\scripts\deploy-stack.ps1
#
# deploy.env is not tracked by Git. This file is the template.

# --- AWS account ---
AWS_REGION=ap-northeast-1
AWS_ACCOUNT_ID=

# --- CodeConnections (GitHub) ---
GITHUB_CONNECTION_ARN=arn:aws:codeconnections:ap-northeast-1:123456789012:connection/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- CloudFormation ---
STACK_NAME=secapp-demo
PROJECT_NAME=secapp-demo

# --- CodePipeline source (GitHub owner/repo) ---
REPOSITORY_ID=pizzica-chan/VulnBench
BRANCH_NAME=master

# --- Secrets (optional; CloudFormation defaults apply if empty) ---
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
